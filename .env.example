DIRECT_URL="postgresql://user:pass@host:5432/mpruy?schema=public"

AUTH_JWT_SECRET=""
API_KEY_PEPPER=""

NINE_ROUTER_URL="http://localhost:20128"
NINE_ROUTER_API_KEY="sk-fc789b7c55bb5dfc-cho8qb-5e39548b"

MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
MIDTRANS_IS_PRODUCTION="false"

APP_BASE_URL="http://localhost:3000"

# Plan untuk user baru saat register (default: free)
SIGNUP_PLAN="free"

RESEND_API_KEY=""
EMAIL_FROM="noreply@mpruy.ai"

# ─── Email ───────────────────────────────────────────────────────────
# Transport: smtp | api | console. Kosong = auto-detect
# (smtp bila SMTP_HOST + password ada, else api bila RESEND_API_KEY ada, else console).
MAIL_TRANSPORT=""

# SMTP — default memakai Resend SMTP (https://resend.com/docs/send-with-smtp)
#   host: smtp.resend.com · username: `resend` · password: API key Resend
SMTP_HOST="smtp.resend.com"
SMTP_PORT="587"          # 465/2465 = SSL implisit · 25/587/2587 = STARTTLS
SMTP_SECURE=""           # kosong = otomatis dari port (465/2465 → true)
SMTP_USER="resend"
SMTP_PASS=""             # = API key Resend; fallback ke RESEND_API_KEY bila kosong
SMTP_ALLOW_SELF_SIGNED=""  # "true" hanya untuk server SMTP internal dengan cert self-signed

# Nama pengirim yang tampil di inbox (opsional)
EMAIL_FROM_NAME="Mpruy AI"
