DATABASE_URL="postgresql://user:pass@host:5432/mpruy?schema=public"
DIRECT_URL="postgresql://user:pass@host:5432/mpruy?schema=public"

AUTH_JWT_SECRET=""
API_KEY_PEPPER=""

NINE_ROUTER_URL="http://localhost:20128"
NINE_ROUTER_API_KEY="sk-fc789b7c55bb5dfc-cho8qb-5e39548b"

# ─── Timeout upstream (ms) ────────────────────────────────────────────
# Batas IDLE, bukan durasi total. Timer di-reset setiap ada byte dari upstream,
# jadi task panjang (30 menit) tetap jalan selama model aktif mengeluarkan token.
# Naikkan bila memakai model reasoning yang bisa "diam" lama sebelum token pertama.
# Default: stream 180000 (3 mnt), non-stream 120000 (2 mnt).
UPSTREAM_STREAM_IDLE_TIMEOUT_MS="180000"
UPSTREAM_TIMEOUT_MS="120000"

MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
MIDTRANS_IS_PRODUCTION="false"

# ─── Batas top-up (dipakai server & client) ───────────────────────────
# NEXT_PUBLIC_ prefix wajib: nilainya dibaca juga di browser.
NEXT_PUBLIC_TOPUP_MIN_IDR="10000"
NEXT_PUBLIC_TOPUP_MAX_IDR="50000000"
NEXT_PUBLIC_TOPUP_STEP_IDR="1000"

# Tombol top-up otomatis Midtrans. Default mati (cukup QRIS manual).
NEXT_PUBLIC_MIDTRANS_ENABLED="false"

# ─── Top-up QRIS manual ──────────────────────────────────────────────
# Payload QRIS statis milik merchant (string TLV, ambil dari hasil scan QR).
# Platform mengubahnya jadi dinamis: nominal = amountIdr + kode unik (1..999).
# Kosongkan untuk mematikan metode top-up QRIS manual.
QRIS_STATIC_PAYLOAD=""
# Masa berlaku transaksi QRIS manual (jam). Setelah lewat, nominal/kode unik dilepas.
QRIS_EXPIRY_HOURS="24"

APP_BASE_URL="http://localhost:3000"

# Plan untuk user baru saat register (default: free)
SIGNUP_PLAN="free"

# ─── Pembelian plan dari saldo ───────────────────────────────────────
# Plan berbayar dibeli user dari saldo (POST /api/billing/plans/purchase).
# Tidak ada recurring: sekali bayar = 30 hari. Lewat 30 hari plan TIDAK
# diturunkan otomatis — admin menurunkannya manual lewat panel admin
# (POST /api/admin/users/:id/plan). Tidak ada cron untuk expiry.

RESEND_API_KEY=""
EMAIL_FROM="noreply@mpruy.ai"

# ─── Email ───────────────────────────────────────────────────────────
# Transport: smtp | api | console. Kosong = auto-detect
# (smtp bila SMTP_HOST + password ada, else api bila RESEND_API_KEY ada, else console).
MAIL_TRANSPORT=""

# SMTP — default memakai Resend SMTP (https://resend.com/docs/send-with-smtp)
#   host: smtp.resend.com · username: `resend` · password: API key Resend
SMTP_HOST="smtp.resend.com"
SMTP_PORT="587"          # 465/2465 = SSL implisit · 25/587/2587 = STARTTLS
SMTP_SECURE=""           # kosong = otomatis dari port (465/2465 → true)
SMTP_USER="resend"
SMTP_PASS=""             # = API key Resend; fallback ke RESEND_API_KEY bila kosong
SMTP_ALLOW_SELF_SIGNED=""  # "true" hanya untuk server SMTP internal dengan cert self-signed

# Nama pengirim yang tampil di inbox (opsional)
EMAIL_FROM_NAME="Mpruy AI"
